# Dependencies
node_modules

# Build output
dist
dist-ssr
build

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env.*
!.env.example
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Go backend
Backend/data/
Backend/*.exe

# MCP servers we ship: the built binary, and the temporary file the Go toolchain
# leaves beside it when the binary was in use while it was being rebuilt
MCP/*/*.exe
MCP/*/*.exe~
MCP/*/*.test

# The agent's workspaces: the files it creates while working
/workspace/

# Wails desktop app. The icon and manifest are source; the executable and
# generated frontend/wails bindings are not.
!Backend/desktop/build/
!Backend/desktop/build/**
Backend/desktop/build/bin/
!Backend/desktop/dist/
Backend/desktop/dist/*
!Backend/desktop/dist/.gitkeep
Backend/desktop/wailsjs/

# Wails' frontend dependency-install fingerprint.
Frontend/package.json.md5

# The desktop build's loopback API address is not a secret.
!Frontend/.env.desktop

# The Windows installer, as built. The script and its Inno Setup source are the
# source; the setup executable is the product of them.
installer/out/
