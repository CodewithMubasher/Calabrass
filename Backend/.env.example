# Calabrass backend — local development
# Copy to .env and fill in real keys. .env is gitignored.

# HTTP listen address
CALABRASS_ADDR=127.0.0.1:8787

# SQLite database file (created automatically)
CALABRASS_DB=data/calabrass.db

# Google Gemini (GoAI provider "google")
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (GoAI provider "groq")
GROQ_API_KEY=

# Order in which providers are offered and used as the fallback
CALABRASS_PROVIDER_PRIORITY=groq,google

# Optional system prompt override
# CALABRASS_SYSTEM_PROMPT=You are Calabrass, a helpful AI assistant.
