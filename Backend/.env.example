# Calabrass backend - local development
#
# Copy this file to the .env in the app's data folder and fill in real keys:
#   Windows: %LOCALAPPDATA%\Calabrass\.env
#   elsewhere: the platform's config folder, e.g. ~/.config/Calabrass/.env
#
# That folder also holds the database and the workspaces the agent works in.
# Nothing the user makes is ever written into this checkout.

# HTTP listen address
CALABRASS_ADDR=127.0.0.1:8787

# Where the database goes. A relative path means "inside the data folder".
# The default is <data folder>/calabrass.db, so this is usually left unset.
# CALABRASS_DB=calabrass.db

# Google Gemini (GoAI provider "google")
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (GoAI provider "groq")
GROQ_API_KEY=

# Order in which providers are offered and used as the fallback
CALABRASS_PROVIDER_PRIORITY=groq,google

# Optional system prompt override
# CALABRASS_SYSTEM_PROMPT=You are Calabrass, a helpful AI assistant.
